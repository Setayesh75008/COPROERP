<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_relance" model="ir.actions.report">
        <field name="name">Lettre de relance / mise en demeure</field>
        <field name="model">coproerp.relance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coproerp_recouvrement.report_relance</field>
        <field name="report_file">coproerp_recouvrement.report_relance</field>
        <field name="print_report_name">'%s - %s' % ((object.name or 'Relance').replace('/', '-'), object.personne_id.name or '')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_coproerp_relance"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
