<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_relance_preparation_form" model="ir.ui.view">
        <field name="name">coproerp.relance.preparation.form</field>
        <field name="model">coproerp.relance.preparation</field>
        <field name="arch" type="xml">
            <form string="Suivi des impayés et relances">
                <group>
                    <group>
                        <field name="copropriete_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <button name="action_rechercher" type="object" string="Rechercher les débiteurs"
                                class="btn-primary" colspan="2"/>
                    </group>
                </group>
                <field name="recherche_faite" invisible="1"/>
                <p class="text-muted" invisible="recherche_faite">
                    Choisissez la copropriété et la date, puis « Rechercher les débiteurs ». Le système propose
                    une lettre de relance (sans frais) puis, si elle reste sans effet, une mise en demeure.
                </p>
                <p class="text-muted" invisible="not recherche_faite or ligne_ids">Aucun copropriétaire débiteur à cette date.</p>
                <field name="ligne_ids" invisible="not recherche_faite or not ligne_ids">
                    <list editable="bottom" create="0" delete="0"
                          decoration-danger="proposition == 'mise_en_demeure'" decoration-muted="proposition == 'aucune'">
                        <field name="a_traiter"/>
                        <field name="personne_id"/>
                        <field name="solde" sum="Total"/>
                        <field name="plus_ancienne"/>
                        <field name="jours_retard"/>
                        <field name="proposition"/>
                        <field name="motif"/>
                    </list>
                </field>
                <footer>
                    <button name="action_preparer" type="object" string="Préparer les lettres cochées"
                            class="btn-primary" invisible="not recherche_faite or not ligne_ids"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_relance_preparation" model="ir.actions.act_window">
        <field name="name">Suivi des impayés et relances</field>
        <field name="res_model">coproerp.relance.preparation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_recouvrement" name="Recouvrement"
              parent="coproerp_comptabilite.menu_comptabilite_root" sequence="30"/>
    <menuitem id="menu_relance_preparation" name="Suivi des impayés et relances"
              parent="menu_recouvrement" action="action_relance_preparation" sequence="10"/>
    <menuitem id="menu_relances" name="Relances et mises en demeure"
              parent="menu_recouvrement" action="action_relance" sequence="20"/>
</odoo>
