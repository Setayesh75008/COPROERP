<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_navigation_coproerp"
            model="ir.ui.view">

        <field name="name">
            res.partner.form.navigation.coproerp
        </field>

        <field name="model">res.partner</field>

        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Navigation">

                    <group>

                        <group string="Lots propriétaires">

                            <field name="lot_proprietaire_ids"
                                   widget="many2many_tags"
                                   readonly="1"/>

                        </group>

                        <group string="Lots occupants">

                            <field name="lot_occupant_ids"
                                   widget="many2many_tags"
                                   readonly="1"/>

                        </group>

                    </group>

                    <group string="Droits">

                        <field name="droit_ids"
                               readonly="1">

                            <list>

                                <field name="reference"/>
                                <field name="lot_id"/>
                                <field name="type_droit"/>
                                <field name="date_debut"/>
                                <field name="date_fin"/>
                                <field name="active"/>

                            </list>

                        </field>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>