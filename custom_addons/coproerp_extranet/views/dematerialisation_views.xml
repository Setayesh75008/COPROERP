<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_demat_list" model="ir.ui.view">
        <field name="name">coproerp.demat.consentement.list</field>
        <field name="model">coproerp.demat.consentement</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="date"/>
                <field name="personne_id"/>
                <field name="type_envoi"/>
                <field name="accord" widget="boolean"/>
                <field name="origine"/>
                <field name="email" optional="show"/>
                <field name="adresse_ip" optional="hide"/>
                <field name="utilisateur_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_demat_form" model="ir.ui.view">
        <field name="name">coproerp.demat.consentement.form</field>
        <field name="model">coproerp.demat.consentement</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Chaque ligne est une preuve : elle ne peut plus être modifiée une fois
                        enregistrée. Pour changer l'état, enregistrez un nouvel accord ou un retrait.
                    </div>
                    <group>
                        <group>
                            <field name="personne_id" readonly="id"/>
                            <field name="type_envoi" readonly="id"/>
                            <field name="accord" readonly="id"/>
                            <field name="origine" readonly="id"/>
                            <field name="email" readonly="id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="utilisateur_id"/>
                            <field name="adresse_ip"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_demat_search" model="ir.ui.view">
        <field name="name">coproerp.demat.consentement.search</field>
        <field name="model">coproerp.demat.consentement</field>
        <field name="arch" type="xml">
            <search>
                <field name="personne_id"/>
                <filter name="accords" string="Accords" domain="[('accord', '=', True)]"/>
                <filter name="retraits" string="Retraits" domain="[('accord', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type d'envoi" context="{'group_by': 'type_envoi'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_demat" model="ir.actions.act_window">
        <field name="name">Accords de dématérialisation</field>
        <field name="res_model">coproerp.demat.consentement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
