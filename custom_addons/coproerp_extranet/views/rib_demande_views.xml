<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_rib_demande_list" model="ir.ui.view">
        <field name="name">coproerp.rib.demande.list</field>
        <field name="model">coproerp.rib.demande</field>
        <field name="arch" type="xml">
            <list decoration-info="etat == 'nouveau'">
                <field name="create_date" string="Reçu le"/>
                <field name="personne_id"/>
                <field name="copropriete_id"/>
                <field name="etat"/>
            </list>
        </field>
    </record>

    <record id="view_rib_demande_form" model="ir.ui.view">
        <field name="name">coproerp.rib.demande.form</field>
        <field name="model">coproerp.rib.demande</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="etat" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="personne_id"/>
                            <field name="copropriete_id"/>
                        </group>
                        <group>
                            <field name="fichier" filename="nom_fichier"/>
                            <field name="nom_fichier" invisible="1"/>
                            <field name="create_date" string="Reçu le"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Observations..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rib_demande" model="ir.actions.act_window">
        <field name="name">Demandes de prélèvement</field>
        <field name="res_model">coproerp.rib.demande</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
