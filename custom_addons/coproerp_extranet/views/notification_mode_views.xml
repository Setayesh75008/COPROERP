<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_notification_mode_list" model="ir.ui.view">
        <field name="name">coproerp.notification.mode.list</field>
        <field name="model">coproerp.notification.mode</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="personne_id"/>
                <field name="objet"/>
                <field name="email" optional="show"/>
                <field name="origine"/>
                <field name="date_reception"/>
                <field name="date_effet"/>
                <field name="utilisateur_id" optional="hide"/>
                <field name="adresse_ip" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_notification_mode_form" model="ir.ui.view">
        <field name="name">coproerp.notification.mode.form</field>
        <field name="model">coproerp.notification.mode</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Les notifications et mises en demeure sont faites par voie électronique ; le
                        copropriétaire peut à tout moment demander la voie postale (art. 42-1 de la loi du
                        10 juillet 1965). La demande prend effet le 9e jour suivant sa réception par le
                        syndic, ou immédiatement si elle est faite en assemblée générale.
                        Chaque ligne est une preuve : elle ne peut plus être modifiée.
                    </div>
                    <group>
                        <group>
                            <field name="personne_id" readonly="id"/>
                            <field name="objet" readonly="id"/>
                            <field name="email" readonly="id" invisible="objet != 'adresse'"
                                   required="objet == 'adresse'"/>
                            <field name="origine" readonly="id"/>
                            <field name="note" readonly="id"/>
                        </group>
                        <group>
                            <field name="date_reception" readonly="id"/>
                            <field name="date_effet"/>
                            <field name="date"/>
                            <field name="utilisateur_id"/>
                            <field name="adresse_ip" invisible="not adresse_ip"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_notification_mode_search" model="ir.ui.view">
        <field name="name">coproerp.notification.mode.search</field>
        <field name="model">coproerp.notification.mode</field>
        <field name="arch" type="xml">
            <search>
                <field name="personne_id"/>
                <field name="email"/>
                <filter name="postal" string="Demandes de voie postale" domain="[('objet', '=', 'postal')]"/>
                <filter name="electronique" string="Retours à la voie électronique" domain="[('objet', '=', 'electronique')]"/>
                <filter name="adresse" string="Adresses communiquées" domain="[('objet', '=', 'adresse')]"/>
                <group>
                    <filter name="group_personne" string="Copropriétaire" context="{'group_by': 'personne_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_notification_mode" model="ir.actions.act_window">
        <field name="name">Réception des notifications</field>
        <field name="res_model">coproerp.notification.mode</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Enregistrez ici les demandes de réception par voie postale reçues par courrier, par
            courrier électronique ou formulées en assemblée générale, et les adresses électroniques
            communiquées pour les notifications. Les demandes faites depuis l'espace en ligne
            s'enregistrent automatiquement.</p>
        </field>
    </record>
</odoo>
