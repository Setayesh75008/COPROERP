<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nature_depense_list" model="ir.ui.view">
        <field name="name">coproerp.nature.depense.list</field>
        <field name="model">coproerp.nature.depense</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="travaux"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_nature_depense" model="ir.actions.act_window">
        <field name="name">Natures de dépenses</field>
        <field name="res_model">coproerp.nature.depense</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p>Chaque nature correspond à un compte de charges du plan comptable des copropriétés
            (décret n° 2005-240). Le numéro de compte doit exister dans le dossier comptable.</p>
        </field>
    </record>
</odoo>
