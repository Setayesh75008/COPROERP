<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_depense_paiement_list" model="ir.ui.view">
        <field name="name">coproerp.depense.paiement.list</field>
        <field name="model">coproerp.depense.paiement</field>
        <field name="arch" type="xml">
            <list decoration-muted="etat == 'annule'" decoration-info="etat == 'brouillon'">
                <field name="date"/>
                <field name="name"/>
                <field name="copropriete_id"/>
                <field name="fournisseur_id"/>
                <field name="depense_id"/>
                <field name="mode"/>
                <field name="reference"/>
                <field name="montant" sum="Total"/>
                <field name="etat" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_depense_paiement_form" model="ir.ui.view">
        <field name="name">coproerp.depense.paiement.form</field>
        <field name="model">coproerp.depense.paiement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_valider" type="object" string="Valider le paiement"
                            class="oe_highlight" invisible="etat != 'brouillon'"/>
                    <button name="action_annuler" type="object" string="Annuler (erreur, chèque non débité…)"
                            invisible="etat != 'valide'"
                            confirm="Une écriture inverse sera passée et la facture redeviendra due. Continuer ?"/>
                    <field name="etat" widget="statusbar" statusbar_visible="brouillon,valide"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="depense_id" readonly="etat != 'brouillon'"/>
                            <field name="copropriete_id"/>
                            <field name="fournisseur_id"/>
                        </group>
                        <group>
                            <field name="date" readonly="etat != 'brouillon'"/>
                            <field name="montant" readonly="etat != 'brouillon'"/>
                            <field name="mode" readonly="etat != 'brouillon'"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <group invisible="etat == 'brouillon'">
                        <field name="move_id"/>
                        <field name="move_annulation_id" invisible="not move_annulation_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Fenêtre ouverte depuis la facture (bouton « Enregistrer un paiement ») -->
    <record id="view_depense_paiement_form_dialog" model="ir.ui.view">
        <field name="name">coproerp.depense.paiement.form.dialog</field>
        <field name="model">coproerp.depense.paiement</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="depense_id" readonly="1" force_save="1"/>
                        <field name="fournisseur_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="montant"/>
                        <field name="mode"/>
                        <field name="reference"/>
                    </group>
                </group>
                <footer>
                    <button name="action_valider" type="object" string="Valider le paiement" class="btn-primary"/>
                    <button special="cancel" string="Fermer"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_depense_paiement_search" model="ir.ui.view">
        <field name="name">coproerp.depense.paiement.search</field>
        <field name="model">coproerp.depense.paiement</field>
        <field name="arch" type="xml">
            <search>
                <field name="fournisseur_id"/>
                <field name="copropriete_id"/>
                <field name="depense_id"/>
                <field name="reference"/>
                <filter name="valide" string="Réalisés" domain="[('etat', '=', 'valide')]"/>
                <group>
                    <filter name="group_copro" string="Copropriété" context="{'group_by': 'copropriete_id'}"/>
                    <filter name="group_fournisseur" string="Fournisseur" context="{'group_by': 'fournisseur_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_depense_paiement" model="ir.actions.act_window">
        <field name="name">Paiements fournisseurs</field>
        <field name="res_model">coproerp.depense.paiement</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_depense_paiement_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_depense_paiement_form')})]"/>
        <field name="help" type="html">
            <p>Les paiements s'enregistrent depuis la facture (bouton « Enregistrer un paiement »).</p>
        </field>
    </record>
</odoo>
