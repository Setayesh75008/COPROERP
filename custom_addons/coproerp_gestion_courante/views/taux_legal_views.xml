<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_taux_legal_list" model="ir.ui.view">
        <field name="name">coproerp.taux.legal.list</field>
        <field name="model">coproerp.taux.legal</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="taux_autres"/>
                <field name="taux_particuliers"/>
            </list>
        </field>
    </record>
    <record id="action_taux_legal" model="ir.actions.act_window">
        <field name="name">Taux de l'intérêt légal</field>
        <field name="res_model">coproerp.taux.legal</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Les taux sont fixés chaque semestre par arrêté (publié en juin et en décembre) : ajoutez le nouveau
            semestre dès sa publication.</p>
        </field>
    </record>
    <menuitem id="menu_taux_legal" name="Taux de l'intérêt légal"
              parent="coproerp_recouvrement.menu_recouvrement" action="action_taux_legal" sequence="90"/>
</odoo>
