<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_revision">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="r">
                <t t-set="bail" t-value="r.bail_id.sudo()"/>
                <t t-call="web.external_layout">
                    <div class="page o_loc">
                        <t t-call="coproerp_locatif.style_locatif"/>
                        <t t-call="coproerp_locatif.entete_locataire">
                            <t t-set="titre" t-value="'RÉVISION DU LOYER'"/>
                            <t t-set="destinataire" t-value="bail.locataire_id"/>
                            <t t-set="date_doc" t-value="r.write_date.date()"/>
                        </t>
                        <p class="mt-4">Madame, Monsieur,</p>
                        <p>Conformément à la clause de révision de votre bail, le loyer est révisé chaque année à la date
                            du <b t-out="bail.date_fr(r.date_revision)"/> en fonction de la variation de l'indice
                            <b t-out="(r.type_indice or '').upper()"/> publié par l'INSEE.</p>
                        <table class="o_loc_detail">
                            <tr><th>Élément</th><th class="text-end">Valeur</th></tr>
                            <tr><td>Indice de référence (<t t-out="r.trimestre"/> <t t-out="r.annee_ancienne"/>)</td><td class="text-end" t-out="'%.2f' % r.valeur_ancienne"/></tr>
                            <tr><td>Nouvel indice (<t t-out="r.trimestre"/> <t t-out="r.annee_nouvelle"/>)</td><td class="text-end" t-out="'%.2f' % r.valeur_nouvelle"/></tr>
                            <tr><td>Loyer mensuel hors charges actuel</td><td class="text-end" t-out="bail.euros(r.loyer_ancien)"/></tr>
                            <tr class="o_loc_total"><td>Nouveau loyer mensuel hors charges
                                (<t t-out="bail.euros(r.loyer_ancien)"/> × <t t-out="'%.2f' % r.valeur_nouvelle"/> ÷ <t t-out="'%.2f' % r.valeur_ancienne"/>)</td>
                                <td class="text-end" t-out="bail.euros(r.loyer_nouveau)"/></tr>
                        </table>
                        <p class="mt-3">Ce nouveau loyer s'applique à compter du
                            <b t-out="bail.date_fr(r.date_effet or r.date_revision)"/>. Les provisions sur charges restent
                            inchangées.</p>
                        <p>Nous vous prions d'agréer, Madame, Monsieur, l'expression de nos salutations distinguées.</p>
                        <div class="mt-4" style="margin-left: 55%;">
                            <div>Pour le bailleur, le gestionnaire,</div>
                            <div><b t-out="env.company.name"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
