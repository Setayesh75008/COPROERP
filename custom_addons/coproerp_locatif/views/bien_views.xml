<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bien_list" model="ir.ui.view">
        <field name="name">coproerp.locatif.bien.list</field>
        <field name="model">coproerp.locatif.bien</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type_bien"/>
                <field name="proprietaire_id"/>
                <field name="city"/>
                <field name="surface"/>
                <field name="bail_en_cours_id"/>
                <field name="occupe"/>
            </list>
        </field>
    </record>
    <record id="view_bien_form" model="ir.ui.view">
        <field name="name">coproerp.locatif.bien.form</field>
        <field name="model">coproerp.locatif.bien</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ex. : Appartement T3, 2e étage gauche"/></h1></div>
                    <group>
                        <group string="Bien">
                            <field name="type_bien"/>
                            <field name="mandat_id"/>
                            <field name="proprietaire_id"/>
                            <field name="surface"/>
                            <field name="nombre_pieces"/>
                            <field name="meuble"/>
                            <field name="classe_energie"/>
                            <field name="lot_id"/>
                        </group>
                        <group string="Adresse">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="zone_tendue"/>
                            <field name="bail_en_cours_id"/>
                        </group>
                    </group>
                    <field name="bail_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="type_bail"/>
                            <field name="locataire_id"/>
                            <field name="date_debut"/>
                            <field name="date_sortie"/>
                            <field name="etat" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_bien" model="ir.actions.act_window">
        <field name="name">Biens</field>
        <field name="res_model">coproerp.locatif.bien</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
