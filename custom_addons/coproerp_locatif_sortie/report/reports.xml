<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_etat_lieux" model="ir.actions.report">
        <field name="name">État des lieux</field>
        <field name="model">coproerp.locatif.etat_lieux</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coproerp_locatif_sortie.report_etat_lieux</field>
        <field name="report_file">coproerp_locatif_sortie.report_etat_lieux</field>
        <field name="print_report_name">'Etat des lieux %s' % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_coproerp_locatif_etat_lieux"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_sortie" model="ir.actions.report">
        <field name="name">Décompte de sortie</field>
        <field name="model">coproerp.locatif.sortie</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coproerp_locatif_sortie.report_sortie</field>
        <field name="report_file">coproerp_locatif_sortie.report_sortie</field>
        <field name="print_report_name">'Decompte de sortie %s' % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_coproerp_locatif_sortie"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
