<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================== -->
    <!-- Vue Liste             -->
    <!-- ===================== -->

    <record id="view_lot_tree" model="ir.ui.view">
        <field name="name">coproerp.lot.list</field>
        <field name="model">coproerp.lot</field>

        <field name="arch" type="xml">
            <list>
                <field name="numero"/>
                <field name="designation"/>
                <field name="copropriete_id"/>
                <field name="batiment_id"/>
                <field name="type_lot"/>
                <field name="usage"/>
                <field name="surface"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- ===================== -->
    <!-- Vue Formulaire        -->
    <!-- ===================== -->

    <record id="view_lot_form" model="ir.ui.view">
        <field name="name">coproerp.lot.form</field>
        <field name="model">coproerp.lot</field>

        <field name="arch" type="xml">
            <form>

                <sheet>

                    <group>

                        <group>
                            <field name="numero"/>
                            <field name="designation"/>
                        </group>

                        <group>
                            <field name="copropriete_id" readonly="1"/>
                            <field name="batiment_id"/>
                            <field name="type_lot"/>
                            <field name="usage"/>
                            <field name="active"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Description">
                            <group>
                                <field name="surface"/>
                                <field name="tantiemes"/>
                                <field name="etage"/>
                            </group>
                        </page>

                        <page string="Propriétaires et occupants">

                            <group>

                                <group string="Propriétaires">
                                    <field
                                        name="proprietaire_ids"
                                        widget="many2many_tags"
                                        options="{'no_create_edit': False}"
                                    />
                                </group>

                                <group string="Occupants">
                                    <field
                                        name="occupant_ids"
                                        widget="many2many_tags"
                                        options="{'no_create_edit': False}"
                                    />
                                </group>

                            </group>

                        </page>

                        <page string="Observations">
                            <field name="note"/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <!-- ===================== -->
    <!-- Action                -->
    <!-- ===================== -->

    <record id="action_lots" model="ir.actions.act_window">
        <field name="name">Lots</field>
        <field name="res_model">coproerp.lot</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>