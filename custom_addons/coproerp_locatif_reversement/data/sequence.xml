<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_depense" model="ir.sequence">
            <field name="name">Factures payées pour le compte des propriétaires</field>
            <field name="code">coproerp.locatif.depense</field>
            <field name="prefix">FP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_compte_rendu" model="ir.sequence">
            <field name="name">Comptes rendus de gestion</field>
            <field name="code">coproerp.locatif.compte_rendu</field>
            <field name="prefix">CRG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_reversement" model="ir.sequence">
            <field name="name">Virements des fonds des mandants</field>
            <field name="code">coproerp.locatif.reversement</field>
            <field name="prefix">VIR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
