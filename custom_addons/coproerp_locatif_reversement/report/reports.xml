<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_compte_rendu" model="ir.actions.report">
        <field name="name">Compte rendu de gestion</field>
        <field name="model">coproerp.locatif.compte_rendu</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coproerp_locatif_reversement.report_compte_rendu</field>
        <field name="report_file">coproerp_locatif_reversement.report_compte_rendu</field>
        <field name="print_report_name">'Compte rendu %s' % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_coproerp_locatif_compte_rendu"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_recap_fiscal" model="ir.actions.report">
        <field name="name">Récapitulatif des revenus fonciers</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coproerp_locatif_reversement.report_recap_fiscal</field>
        <field name="report_file">coproerp_locatif_reversement.report_recap_fiscal</field>
        <field name="print_report_name">'Revenus fonciers %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
