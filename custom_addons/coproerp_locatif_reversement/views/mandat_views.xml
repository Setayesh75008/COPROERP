<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mandat_form_reversement" model="ir.ui.view">
        <field name="name">coproerp.locatif.mandat.form.reversement</field>
        <field name="model">coproerp.locatif.mandat</field>
        <field name="inherit_id" ref="coproerp_locatif.view_mandat_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_voir_comptes_rendus" type="object" class="oe_stat_button" icon="fa-list-alt"
                        string="Comptes rendus"/>
            </xpath>
            <xpath expr="//header/field[@name='etat']" position="before">
                <button name="action_preparer_virement" type="object" string="Virer au propriétaire"
                        invisible="etat != 'actif'"/>
            </xpath>
            <xpath expr="//field[@name='reversement']" position="after">
                <field name="reserve"/>
                <field name="solde_proprietaire"/>
                <field name="impayes_proprietaire"/>
                <field name="disponible"/>
            </xpath>
        </field>
    </record>
</odoo>
