<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================== -->
    <!-- Vue Liste             -->
    <!-- ===================== -->

    <record id="view_droit_tree" model="ir.ui.view">
    <field name="name">coproerp.droit.list</field>
    <field name="model">coproerp.droit</field>

    <field name="arch" type="xml">
        <list>
            <field name="reference"/>
            <field name="personne_id"/>
            <field name="lot_id"/>
            <field name="type_droit"/>
            <field name="quotite"/>
            <field name="date_debut"/>
            <field name="date_fin"/>
            <field name="active"/>
        </list>
    </field>
</record>

    <!-- ===================== -->
    <!-- Vue Formulaire        -->
    <!-- ===================== -->

    <record id="view_droit_form" model="ir.ui.view">
    <field name="name">coproerp.droit.form</field>
    <field name="model">coproerp.droit</field>

    <field name="arch" type="xml">
        <form>

            <sheet>

                <group>

                    <group>

                        <field name="reference"/>
                        <field name="personne_id"/>
                        <field name="lot_id"/>
                        <field name="type_droit"/>

                    </group>

                    <group>

                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="active"/>

                    </group>

                </group>

                <notebook>

                    <page string="Observations">

                        <field name="note"/>

                    </page>

                </notebook>

            </sheet>

        </form>
    </field>
</record>

    <!-- ===================== -->
    <!-- Action                -->
    <!-- ===================== -->

    <record id="action_droits" model="ir.actions.act_window">
    <field name="name">Droits</field>
    <field name="res_model">coproerp.droit</field>
    <field name="view_mode">list,form</field>
</record>

</odoo>