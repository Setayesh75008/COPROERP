<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reglement_list" model="ir.ui.view">
        <field name="name">coproerp.reglement.list</field>
        <field name="model">coproerp.reglement</field>
        <field name="arch" type="xml">
            <list decoration-muted="etat == 'annule'" decoration-info="etat == 'brouillon'">
                <field name="date"/>
                <field name="name"/>
                <field name="copropriete_id"/>
                <field name="personne_id"/>
                <field name="mode"/>
                <field name="reference"/>
                <field name="montant" sum="Total"/>
                <field name="etat" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_reglement_form" model="ir.ui.view">
        <field name="name">coproerp.reglement.form</field>
        <field name="model">coproerp.reglement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_valider" type="object" string="Valider et imputer"
                            class="oe_highlight" invisible="etat != 'brouillon'"
                            confirm="Le règlement sera comptabilisé et imputé sur les appels les plus anciens. Continuer ?"/>
                    <button name="action_annuler" type="object" string="Annuler (impayé / erreur)"
                            invisible="etat != 'valide'"
                            confirm="Une écriture inverse sera passée et les appels redeviendront dus. Continuer ?"/>
                    <field name="etat" widget="statusbar" statusbar_visible="brouillon,valide"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="copropriete_id" readonly="etat != 'brouillon'"/>
                            <field name="personne_id" readonly="etat != 'brouillon'"/>
                            <field name="date" readonly="etat != 'brouillon'"/>
                        </group>
                        <group>
                            <field name="montant" readonly="etat != 'brouillon'"/>
                            <field name="mode" readonly="etat != 'brouillon'"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <group invisible="etat == 'brouillon'">
                        <field name="imputation"/>
                        <field name="move_id"/>
                        <field name="move_annulation_id" invisible="not move_annulation_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reglement_search" model="ir.ui.view">
        <field name="name">coproerp.reglement.search</field>
        <field name="model">coproerp.reglement</field>
        <field name="arch" type="xml">
            <search>
                <field name="personne_id"/>
                <field name="copropriete_id"/>
                <field name="reference"/>
                <filter name="brouillon" string="À valider" domain="[('etat', '=', 'brouillon')]"/>
                <filter name="valide" string="Validés" domain="[('etat', '=', 'valide')]"/>
                <group>
                    <filter name="group_copro" string="Copropriété" context="{'group_by': 'copropriete_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reglement" model="ir.actions.act_window">
        <field name="name">Règlements des copropriétaires</field>
        <field name="res_model">coproerp.reglement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Saisissez un premier règlement</p>
            <p>À la validation, il est comptabilisé en banque et imputé sur les appels les plus anciens.</p>
        </field>
    </record>
</odoo>
